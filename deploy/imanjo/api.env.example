# =============================================================================
# Backend Production Environment — api.imanjo.com
# =============================================================================
# Drafted from deploy/alemancenter/api.env.example during the imanjo.com migration.
# Every REPLACE_* placeholder needs a real value before this file is usable.
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8082
APP_URL=https://api.imanjo.com
FRONTEND_URL=https://imanjo.com

# CORS / proxy
CORS_ALLOWED_ORIGINS=https://imanjo.com,https://www.imanjo.com
# The old file hardcoded the CURRENT server's IP (152.53.208.71) here — confirm whether
# imanjo.com is deployed on the SAME server (keep it) or a different one (replace it)
# before reusing this list as-is.
TRUSTED_PROXIES=127.0.0.1,::1,REPLACE_WITH_SERVER_IP
SSR_TRUSTED_IPS=127.0.0.1,::1

# Must match frontend FRONTEND_API_KEY exactly (Astro/.env). This does NOT need to be a
# new value for the domain migration — it can be rotated independently, but both sides
# must always hold the identical string.
FRONTEND_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS

# Protects /api/ping, /api/health, and /metrics for remote monitoring.
# Direct localhost checks are allowed without this header.
# Remote monitors must send: X-Internal-Monitor-Key: this_value
INTERNAL_MONITOR_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# Databases — all 4 country connections are required (see internal/config/config.go).
# The old example file only templated _JO; expanded here since all 4 are load-bearing.
DB_HOST_JO=127.0.0.1
DB_PORT_JO=3306
DB_NAME_JO=REPLACE_DB
DB_USER_JO=REPLACE_USER
DB_PASSWORD_JO=REPLACE_PASSWORD

DB_HOST_SA=127.0.0.1
DB_PORT_SA=3306
DB_NAME_SA=REPLACE_DB
DB_USER_SA=REPLACE_USER
DB_PASSWORD_SA=REPLACE_PASSWORD

DB_HOST_EG=127.0.0.1
DB_PORT_EG=3306
DB_NAME_EG=REPLACE_DB
DB_USER_EG=REPLACE_USER
DB_PASSWORD_EG=REPLACE_PASSWORD

DB_HOST_PS=127.0.0.1
DB_PORT_PS=3306
DB_NAME_PS=REPLACE_DB
DB_USER_PS=REPLACE_USER
DB_PASSWORD_PS=REPLACE_PASSWORD

# utf8mb4 is required — an empty/default value here caused real mojibake bugs earlier
# in this project. Do not leave this unset.
DB_CHARSET=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage — confirm this path exists on the imanjo.com VHost with real files migrated
# into it before going live; do not just copy this literal path from the old domain.
STORAGE_DRIVER=local
STORAGE_PATH=/var/www/vhosts/imanjo.com/httpdocs/storage/app/public
STORAGE_URL=https://imanjo.com/storage

# GeoIP — resolves visitor country/city for dashboard analytics. Optional: if left empty,
# visitor tracking still works normally, just without location data.
# 1. Create a free account at https://www.maxmind.com/en/geolite2/signup
# 2. Generate a license key (Account → My License Keys)
# 3. Download the GeoLite2-City edition (.mmdb file), or better, set up automatic updates
#    via MaxMind's geoipupdate tool so the database doesn't silently go stale
# 4. Point this at wherever you place the .mmdb file on this server
GEOIP_DB_PATH=/var/www/vhosts/imanjo.com/httpdocs/storage/geoip/GeoLite2-City.mmdb

# Mail — fill real values
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@imanjo.com
MAIL_FROM_NAME=Imanjo

# ──────────────────────────────────────────────
# AdSense — canonical publisher ID
# ──────────────────────────────────────────────
# When set, this value overrides the per-country DB value for adsense_client.
# This guarantees every page on the domain returns the SAME ca-pub-* ID,
# which is required by Google AdSense policy (one account per domain).
#
# UNRESOLVED as of this draft: the old alemancenter deploy example and the actually-
# deployed production mirror disagree on this value (ca-pub-4320033645574547 vs
# ca-pub-2187451543840210) — confirm which AdSense account/publisher ID imanjo.com
# should actually use (it may need to be a DIFFERENT one entirely, since AdSense ties
# publisher IDs to verified domains) before setting this.
ADSENSE_CLIENT=REPLACE_WITH_CONFIRMED_PUBLISHER_ID

# ──────────────────────────────────────────────
# reCAPTCHA (contact form)
# ──────────────────────────────────────────────
# Set this to enable reCAPTCHA on the contact form.
# Without it the form works but is unprotected against bots.
# Get keys at https://www.google.com/recaptcha/admin
# RECAPTCHA_SITE_KEY=YOUR_SITE_KEY
# RECAPTCHA_SECRET_KEY=YOUR_SECRET_KEY

# Chatbot V4 AI Guarded RAG
CHATBOT_AI_ENABLED=true
CHATBOT_AI_PROVIDER=together
CHATBOT_AI_MODEL=openai/gpt-oss-20b
CHATBOT_AI_MODELS=openai/gpt-oss-20b,meta-llama/Llama-3.3-70B-Instruct-Turbo,Qwen/Qwen3-235B-A22B-Instruct-2507-tput,zai-org/GLM-5.1,google/gemma-3n-E4B-it
CHATBOT_AI_MAX_TOKENS=520
CHATBOT_AI_GUEST_LIMIT_10M=5
CHATBOT_AI_USER_LIMIT_10M=15
CHATBOT_AI_DAILY_LIMIT=1000
